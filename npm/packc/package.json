{
  "name": "@altairalabs/packc",
  "version": "1.1.0",
  "type": "module",
  "description": "PromptKit Pack Compiler - Compile and validate prompt packs for LLM applications",
  "bin": {
    "packc": "./bin/packc.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --ci",
    "test:binary": "node bin/packc.js version",
    "lint": "eslint *.js bin/*.js lib/*.js"
  },
  "optionalDependencies": {
    "@altairalabs/packc-darwin-arm64": "1.1.0",
    "@altairalabs/packc-darwin-x64": "1.1.0",
    "@altairalabs/packc-linux-arm64": "1.1.0",
    "@altairalabs/packc-linux-x64": "1.1.0",
    "@altairalabs/packc-win32-arm64": "1.1.0",
    "@altairalabs/packc-win32-x64": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "jest": "^30.2.0"
  },
  "keywords": [
    "llm",
    "prompt",
    "compiler",
    "validation",
    "ai",
    "prompt-engineering",
    "pack",
    "openai",
    "anthropic",
    "gemini"
  ],
  "author": "Altaira Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AltairaLabs/PromptKit.git",
    "directory": "npm/packc"
  },
  "bugs": {
    "url": "https://github.com/AltairaLabs/PromptKit/issues"
  },
  "homepage": "https://github.com/AltairaLabs/PromptKit#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
