{{if ne .provider "mock"}}# API Keys
# promptarena reads API keys from the environment; it does not load this file.
# Export each key in your shell (export OPENAI_API_KEY=...), or copy this file
# to .env, fill it in, and run: set -a; . ./.env; set +a

{{if eq .provider "openai"}}OPENAI_API_KEY=your-openai-api-key-here
{{else if eq .provider "claude"}}CLAUDE_API_KEY=your-claude-api-key-here
{{else if eq .provider "gemini"}}GEMINI_API_KEY=your-gemini-api-key-here
{{end}}{{else}}# No API keys needed for mock provider
{{end}}
