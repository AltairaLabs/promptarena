# Never pack a binary into the main package. The real binaries ship in the
# per-platform @altairalabs/<tool>-<platform>-<arch> packages; a stray local
# build sitting here would otherwise be published to every consumer.
packc
packc.exe

# Ignore archive files
*.tar.gz
*.zip

# Ignore node_modules if testing locally
node_modules/

# Ignore npm pack output
*.tgz

# Ignore test artifacts
coverage/
.nyc_output/

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~
