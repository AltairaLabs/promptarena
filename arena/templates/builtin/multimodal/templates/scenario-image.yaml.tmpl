# yaml-language-server: $schema=https://promptkit.altairalabs.ai/schemas/v1alpha1/scenario.json
apiVersion: promptkit.altairalabs.ai/v1alpha1
kind: Scenario
metadata:
  name: image-analysis

spec:
  id: analyze-image
  task_type: vision
  description: "Test image analysis and description capabilities"

  turns:
    - role: user
      parts:
        - type: text
          text: "Describe this image in detail. What shape is shown, and what colour is it?"
        - type: image
          media:
            # Resolved relative to config.arena.yaml
            file_path: media/red-square.png
            mime_type: image/png
      assertions:
        - type: min_length
          params:
            min: 1
          message: "Response should not be empty"
        - type: contains_any
          params:
            patterns: ["square", "Square"]
          message: "Should identify the shape"
        - type: contains_any
          params:
            patterns: ["red", "Red"]
          message: "Should identify the colour"
        - type: min_length
          params:
            min: 80
          message: "Description should be detailed"
