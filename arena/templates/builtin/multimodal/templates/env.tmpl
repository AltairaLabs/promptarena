# Environment variables for API keys
# promptarena reads API keys from the environment; it does not load this file.
# Export each key in your shell (export OPENAI_API_KEY=...), or copy this file
# to .env, fill it in, and run: set -a; . ./.env; set +a

{{range .providers}}{{if eq . "openai"}}# OpenAI API Key (with vision access)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

{{else if eq . "claude"}}# Claude API Key (Claude 3 with vision)
# Get your key from: https://console.anthropic.com/
CLAUDE_API_KEY=your-claude-api-key-here

{{else if eq . "gemini"}}# Gemini API Key (Gemini with vision)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

{{end}}{{end}}
