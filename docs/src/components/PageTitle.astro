---
/**
 * Custom PageTitle Component
 *
 * Extends Starlight's PageTitle to include a version banner for non-latest docs.
 * Renders starlight-page-actions' PageTitle (Starlight's default title plus the
 * Copy Markdown / Open in ChatGPT / Claude buttons), because this override
 * takes precedence over the one the plugin registers.
 */
import PageActionsTitle from 'starlight-page-actions/overrides/PageTitle.astro';
import VersionBanner from './VersionBanner.astro';
---

<VersionBanner />
<PageActionsTitle />
