# yaml-language-server: $schema=https://promptkit.altairalabs.ai/schemas/v1alpha1/scenario.json
apiVersion: promptkit.altairalabs.ai/v1alpha1
kind: Scenario
metadata:
  name: image-comparison

spec:
  id: compare-images
  task_type: vision
  description: "Test image comparison capabilities"

  turns:
    - role: user
      parts:
        - type: text
          text: "Compare these two images. What are the similarities and differences?"
        - type: image
          media:
            # Resolved relative to config.arena.yaml
            file_path: media/red-square.png
            mime_type: image/png
        - type: image
          media:
            file_path: media/blue-circle.png
            mime_type: image/png
      assertions:
        - type: min_length
          params:
            min: 1
          message: "Response should not be empty"
        - type: contains_any
          params:
            patterns: ["similar", "different", "both", "comparison", "Both"]
          message: "Should compare the images"
        - type: contains_any
          params:
            patterns: ["circle", "Circle", "round"]
          message: "Should identify the circle"
        - type: contains_any
          params:
            patterns: ["square", "Square"]
          message: "Should identify the square"
