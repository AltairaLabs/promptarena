# @astrojs/starlight 0.41.1 peer-requests astro ^7, but the project is pinned to
# astro 6.4.8 (a compatible, tolerated combination — the same set PromptKit docs
# ship). Accept the locked resolution instead of failing on the peer range.
legacy-peer-deps=true
@altairalabs:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
