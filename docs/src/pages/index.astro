---
// The published token layer FIRST, the site's own overrides after: 42 of the 49
// tokens the two share are already byte-identical, and loading the package
// first means the 7 that differ still resolve to this site's values. Purely
// additive — it supplies the ~130 tokens (semantic aliases, the type and space
// scales) that the shared brand components need and this site never had.
// The same theme layer the docs pages load, in the same order. Starlight's
// customCss only reaches Starlight pages, and a landing page is not one — so
// without this the home page and the docs of the same site disagreed on the
// Atlas mapping, the wordmark size and the border-box reset.
import '@altairalabs/atlas-tokens/index.css';
import '@altairalabs/brand/starlight-atlas.css';
import FamilyBar from '@altairalabs/brand/FamilyBar.astro';
import ProductNav from '../components/landing/ProductNav.astro';
import Hero from '../components/landing/Hero.astro';
import DiataxisMatrix from '../components/landing/DiataxisMatrix.astro';
import InstallBand from '../components/landing/InstallBand.astro';
import SiteFooter from '@altairalabs/brand/SiteFooter.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PromptArena — Test, evaluate, and ship AI agents</title>
    <meta
      name="description"
      content="Scenario-based testing, assertions, evals, and CI/CD gates — plus a pack compiler for type-safe, version-controlled agents."
    />
    <link rel="icon" href="/atlas/logo-promptarena.svg" type="image/svg+xml" />
    <!--
      Written out by hand, because this page is not a Starlight page and
      therefore inherits none of Starlight's head — so the one URL anyone
      actually pastes into Slack had no card at all. Keep these in step with
      the title and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PromptArena" />
    <meta property="og:url" content="https://promptarena.altairalabs.ai/" />
    <meta property="og:title" content="PromptArena — Test, evaluate, and ship AI agents" />
    <meta
      property="og:description"
      content="Scenario-based testing, assertions, evals, and CI/CD gates — plus a pack compiler for type-safe, version-controlled agents."
    />
    <meta property="og:image" content="https://promptarena.altairalabs.ai/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PromptArena — test, evaluate, and ship AI agents" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="PromptArena — Test, evaluate, and ship AI agents" />
    <meta
      name="twitter:description"
      content="Scenario-based testing, assertions, evals, and CI/CD gates — plus a pack compiler for type-safe, version-controlled agents."
    />
    <meta name="twitter:image" content="https://promptarena.altairalabs.ai/og-image.png" />
    <script is:inline>
      // Pre-hydration theme init: localStorage -> prefers-color-scheme.
      const t =
        localStorage.getItem('starlight-theme') ||
        (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body>
    <FamilyBar current="promptarena" docsHref="/arena/" />
    <ProductNav />
    <main>
      <Hero />
      <DiataxisMatrix />
      <InstallBand />
    </main>
    <SiteFooter
      current="promptarena"
      logo="/atlas/logo-promptarena.svg"
      tagline="Build, test and iterate on PromptPacks before they ship."
      columns={[
        {
          title: 'Product',
          links: [
            { text: 'Arena', href: '/arena/' },
            { text: 'PackC', href: '/packc/' },
            { text: 'Playground', href: '/arena/' },
          ],
        },
        {
          title: 'Docs',
          links: [
            { text: 'Tutorials', href: '/arena/tutorials/' },
            { text: 'How-to guides', href: '/arena/how-to/' },
            { text: 'Reference', href: '/arena/reference/' },
          ],
        },
      ]}
    />
    <style is:global>
      html {
        background: var(--bg-app);
        color-scheme: dark light;
      }
      body {
        margin: 0;
        font-family: var(--font-sans);
        background: var(--bg-app);
        color: var(--text-body);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      .atlas-inner {
        max-width: 1120px;
        margin: 0 auto;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
    </style>
  </body>
</html>
